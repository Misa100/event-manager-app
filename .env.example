# Copy to .env.local (ignored by git) and adjust. For EAS builds, define the same
# variables as EAS environment variables. All are optional: see lib/config.ts.

# Supabase project (anon key = public key, protected by Row Level Security)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Public URL of the web app, used in sign-up confirmation and password reset e-mails
EXPO_PUBLIC_SITE_URL=https://<your-domain>
